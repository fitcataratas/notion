# Copie este arquivo para ".env" e preencha as senhas.
#   cp .env.example .env
# Gere senhas fortes, por exemplo com:  openssl rand -base64 24

# Endereço pelo qual as pessoas acessam o sistema.
# Para testar no computador:  http://localhost:8080
# No servidor (com cadeado): https://gestao.seudominio.com.br
# Se começar com https://, os cookies de login só funcionam por conexão segura.
APP_URL=http://localhost:8080

# Porta usada só dentro da máquina (o Nginx encaminha para ela)
APP_PORT=8080

# producao | desenvolvimento
APP_ENV=producao

DB_NAME=gestao
DB_USER=gestao
DB_PASS=TROQUE_ESTA_SENHA
DB_ROOT_PASS=TROQUE_ESTA_OUTRA_SENHA
